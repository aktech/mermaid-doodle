{
  "name": "mermaid-doodle",
  "version": "0.1.1",
  "description": "Hand-drawn Mermaid diagrams for any static site, themed from CSS custom properties.",
  "license": "MIT",
  "author": "Amit Kumar",
  "type": "module",
  "keywords": [
    "mermaid",
    "diagram",
    "hand-drawn",
    "css-custom-properties",
    "dark-mode",
    "static-site",
    "hugo",
    "astro",
    "starlight"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/aktech/mermaid-doodle.git"
  },
  "homepage": "https://github.com/aktech/mermaid-doodle#readme",
  "bugs": {
    "url": "https://github.com/aktech/mermaid-doodle/issues"
  },
  "files": [
    "dist"
  ],
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./auto": {
      "types": "./dist/auto.d.ts",
      "import": "./dist/auto.js"
    },
    "./auto.iife.js": "./dist/auto.iife.js",
    "./styles.css": "./dist/styles.css"
  },
  "sideEffects": [
    "**/*.css",
    "./dist/auto.js",
    "./dist/auto.iife.js"
  ],
  "scripts": {
    "build": "tsup",
    "prepack": "npm run build",
    "prepublishOnly": "npm run typecheck && npm test",
    "typecheck": "tsc --noEmit",
    "test": "node --test 'src/**/*.test.ts'",
    "test:dom": "playwright test",
    "screenshots": "npm run build && node scripts/screenshots.mjs"
  },
  "peerDependencies": {
    "mermaid": ">=11"
  },
  "peerDependenciesMeta": {
    "mermaid": {
      "optional": true
    }
  },
  "devDependencies": {
    "@playwright/test": "1.63.0",
    "@types/node": "26.5.0",
    "mermaid": "11.17.2",
    "tsup": "8.5.1",
    "typescript": "5.9.3"
  },
  "overrides": {
    "esbuild": "0.28.2"
  }
}
